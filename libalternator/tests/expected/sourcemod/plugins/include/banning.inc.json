          {
            "tag": "param:command",
            "text": "Command string to identify the ban source."
          },
          {
            "tag": "param:source",
            "text": "Source value passed via BanClient()."
          },
          {
            "tag": "return",
            "text": "Plugin_Handled to block the actual server banning.\nKicking will still occur."
          }
        ]
