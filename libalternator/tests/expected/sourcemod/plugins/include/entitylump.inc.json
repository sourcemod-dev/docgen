    "EntityLumpEntry": {
      "name": "EntityLumpEntry",
      "refLine": 14,
      "docStart": 82,
      "docEnd": 416,
      "docs": {
        "brief": "An ordered list of key / value pairs for a map entity.\nIf the entry in the EntityLump is removed, the handle will error on all operations.\n(The handle will remain valid on the scripting side, and will still need to be deleted.)\n\nWrite operations (update, insert, erase, append) are only allowed during OnMapInit.",
        "tags": [
          {
            "tag": "",
            "text": "An ordered list of key / value pairs for a map entity.\nIf the entry in the EntityLump is removed, the handle will error on all operations.\n(The handle will remain valid on the scripting side, and will still need to be deleted.)\n\nWrite operations (update, insert, erase, append) are only allowed during OnMapInit."
          }
        ]
      },
