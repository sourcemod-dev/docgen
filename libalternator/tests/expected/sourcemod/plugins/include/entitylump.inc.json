        "GetNextKey": {
          "name": "GetNextKey",
          "refLine": 96,
          "docStart": 2965,
          "docEnd": 3888,
          "docs": {
            "brief": "Searches the entry list for an index matching a key starting from a position.\nThis also copies the value from that index into the given buffer.\n\nThis can be used to find the first / only value matching a key, or to iterate over all\nthe values that match said key.",
            "tags": [
              {
                "tag": "",
                "text": "Searches the entry list for an index matching a key starting from a position.\nThis also copies the value from that index into the given buffer.\n\nThis can be used to find the first / only value matching a key, or to iterate over all\nthe values that match said key."
              },
              {
                "tag": "param:key",
                "text": "Key name to search."
              },
              {
                "tag": "param:buffer",
                "text": "Value buffer.  This will contain the result of the next match, or empty\nif no match was found."
              },
              {
                "tag": "param:maxlen",
                "text": "Maximum length of the value buffer."
              },
              {
                "tag": "param:start",
                "text": "An index after which to begin searching from.  Use -1 to start from the\nfirst entry."
              },
              {
                "tag": "return",
                "text": "Position after start with an entry matching the given key, or -1 if no\nmatch was found."
              },
              {
                "tag": "error",
                "text": "Invalid start position; must be a value between -1 and one less than the\nlength of the entry."
              }
            ]
          },
          "metadata": null,
          "kind": "stock",
          "returnType": "int",
          "arguments": [
            {
              "type": "const char[]",
              "name": "key",
              "decl": "const char[] key",
              "default": null
            },
            {
              "type": "char[]",
              "name": "buffer",
              "decl": "char[] buffer",
              "default": null
            },
            {
              "type": "int",
              "name": "maxlen",
              "decl": "int maxlen",
              "default": null
            },
            {
              "type": "int",
              "name": "start",
              "decl": "int start",
              "default": "-1"
            }
          ]
        },
