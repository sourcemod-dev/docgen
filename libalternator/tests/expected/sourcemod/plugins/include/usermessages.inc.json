      "docs": {
        "brief": "Starts a usermessage (network message).",
        "tags": [
          {
            "tag": "",
            "text": "Starts a usermessage (network message)."
          },
          {
            "tag": "note",
            "text": "Only one message can be active at a time."
          },
          {
            "tag": "note",
            "text": "It is illegal to send any message while a non-intercept hook is in progress."
          },
          {
            "tag": "param:msgname",
