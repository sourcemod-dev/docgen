      "refLine": 189,
      "docStart": 6718,
      "docEnd": 7332,
      "docs": {
        "brief": "Sort comparison function for ADT Array elements. Function provides you with\nindexes currently being sorted, use ADT Array functions to retrieve the\nindex values and compare.",
        "tags": [
          {
            "tag": "",
            "text": "Sort comparison function for ADT Array elements. Function provides you with\nindexes currently being sorted, use ADT Array functions to retrieve the\nindex values and compare."
          },
          {
            "tag": "param:index1",
            "text": "First index to compare."
          },
          {
            "tag": "param:index2",
            "text": "Second index to compare."
          },
          {
            "tag": "param:array",
            "text": "Array that is being sorted (order is undefined)."
          },
          {
            "tag": "param:hndl",
            "text": "Handle optionally passed in while sorting."
          },
          {
            "tag": "return",
            "text": "-1 if first should go before second\n0 if first is equal to second\n1 if first should go after second"
          }
        ]
      },
