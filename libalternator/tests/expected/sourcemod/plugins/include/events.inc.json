      "docStart": 8316,
      "docEnd": 8900,
      "docs": {
        "brief": "Creates a game event to be fired later.\n\nThe Handle should not be closed via CloseHandle().  It must be closed via\nevent.Fire() or event.Cancel().",
        "tags": [
          {
            "tag": "",
            "text": "Creates a game event to be fired later.\n\nThe Handle should not be closed via CloseHandle().  It must be closed via\nevent.Fire() or event.Cancel()."
          },
          {
            "tag": "param:name",
            "text": "Name of event."
          },
          {
            "tag": "param:force",
            "text": "If set to true, this forces the event to be created even if it's not being hooked.\nNote that this will not force it if the event doesn't exist at all."
          },
          {
            "tag": "return",
            "text": "Handle to event. INVALID_HANDLE is returned if the event doesn't exist or isn't\nbeing hooked (unless force is true)."
          }
